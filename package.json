{
  "name": "verse-prod",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/identity/migrate.ts",
    "identity:role": "tsx --env-file-if-exists=.env.local scripts/identity/operator.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e:identity": "playwright test --config playwright.identity.config.ts"
  },
  "dependencies": {
    "better-auth": "1.7.28",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.81.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "postgres": "3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
