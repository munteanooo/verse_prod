# Optional canonical origin for the public site. Required for authentication.
# VERSE_SITE_URL=http://localhost:3000

# Set a runtime URL and secret together to enable identity.
# Use different PostgreSQL runtime and operator roles in deployed environments.
# Remote URLs require sslmode=verify-full.
# DATABASE_URL=postgresql://verse_runtime@127.0.0.1:5432/verse_prod
# DATABASE_MIGRATION_URL=postgresql://verse_operator@127.0.0.1:5432/verse_prod
# Generate with: node -p 'require("node:crypto").randomBytes(32).toString("base64url")'
# BETTER_AUTH_SECRET=

# SMTP is optional for signed-in requests and required for email delivery.
# Local Mailpit example. Remote delivery requires smtps and verified TLS.
# VERSE_SMTP_URL=smtp://127.0.0.1:1025
# VERSE_EMAIL_FROM=verse@example.test

# For integration tests only. Restricted to loopback and databases ending in _test.
# TEST_DATABASE_URL=postgresql://verse_test@127.0.0.1:5432/verse_prod_test

# Storage is optional for reads of the catalog and required for files/publication.
# Explicit local development/tests only. Use a private absolute path outside public/.
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_ROOT=/absolute/path/to/private/verse-files

# Hosted production uses a private S3-compatible bucket after provider approval.
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://example.invalid
# STORAGE_REGION=auto
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Optional processing limits. Defaults and supported ranges are documented.
# STORAGE_PDF_BYTES=8000000
# STORAGE_IMAGE_BYTES=3000000
# STORAGE_SOURCE_PAGES=8
# STORAGE_SOURCE_MM=1800
# STORAGE_OUTPUT_PAGES=70
# STORAGE_OUTPUT_BYTES=12000000
# STORAGE_WORKER_MS=6500
# STORAGE_CONCURRENT=2
